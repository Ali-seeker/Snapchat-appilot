<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/primary_accent"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Day 1 Delivery Baseline • Policy-Compliant Companion"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

    <!-- Setup & Transparency Card (FR-01) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_bg"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_setup_disclosure"
            android:textColor="@color/text_white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disclosure_text"
            android:textColor="@color/text_muted"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />
    </LinearLayout>

    <!-- Permission & Service Status (FR-02) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/card_bg"
        android:padding="16dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_accessibility_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_accessibility_off"
            android:textColor="@color/status_amber"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_ws_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/status_ws_disconnected"
            android:textColor="@color/status_red"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_open_accessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/btn_enable_accessibility"
            android:backgroundTint="@color/primary_accent"
            android:textColor="@color/bg_dark"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Emergency STOP (FR-03) -->
    <Button
        android:id="@+id/btn_emergency_stop"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="@string/btn_emergency_stop"
        android:backgroundTint="@color/status_red"
        android:textColor="@color/text_white"
        android:textStyle="bold"
        android:textSize="16sp" />

</LinearLayout>
